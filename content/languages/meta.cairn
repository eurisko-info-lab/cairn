language meta {
  fragment meta provides meta requires grammar {
    sort FragmentD tree;
    keyword language;
    keyword surface;
    keyword for;
    keyword fragment;
    keyword provides;
    keyword requires;
    keyword sort;
    keyword tree;
    keyword graph;
    keyword ctor;
    keyword binds;
    keyword in;
    keyword varctor;
    keyword rule;
    keyword judgment;
    keyword top;
    keyword where;
    keyword key;
    keyword by;
    keyword provider;
    keyword validate;
    keyword satisfies;
    keyword fromleaf;
    keyword bytag;
    keyword sumleavesatmost;
    keyword uniquetuples;
    keyword nonemptyleaves;
    keyword definedref;
    keyword definedrefs;
    keyword definedleaflist;
    keyword definednodelistrefs;
    keyword leafok;
    keyword leafvalueinctorfield;
    keyword reftagin;
    keyword uniquetupleslist;
    keyword listchilddefinedrefs;
    keyword keyedlocaleoverlay;
    keyword outlinenums;
    punct "{";
    punct "}";
    punct "(";
    punct ")";
    punct ":";
    punct ";";
    punct ",";
    punct "=>";
    punct "|-";
    punct "$";
    punct "=";
    punct "[";
    punct "]";
    punct ".";
    identcont "-";
    syntax file += file : tok "language" anyident tok "{" star cat fragmentDecl tok "}";
    syntax file += surfaceFile : tok "surface" anyident tok "for" anyident tok "{" star cat fragmentDecl tok "}";
    syntax fragmentDecl += fragmentDecl : tok "fragment" anyident opt cat providesClause opt cat requiresClause tok "{" star cat item tok "}";
    syntax providesClause += provides : tok "provides" sepby1 anyident ",";
    syntax requiresClause += requires : tok "requires" sepby1 anyident ",";
    syntax item += sortTree : tok "sort" anyident tok "tree" tok ";";
    syntax item += sortGraph : tok "sort" anyident tok "graph" tok ";";
    syntax item += ctorDecl : tok "ctor" anyident tok ":" anyident opt cat argList star cat bindsClause tok ";";
    syntax item += varCtorDecl : tok "varctor" anyident tok ";";
    syntax item += ruleDecl : tok "rule" anyident tok ":" cat pat tok "=>" cat pat tok ";";
    syntax item += judgmentDecl : tok "judgment" anyident tok "{" star cat judgRule tok "}";
    syntax item += topDecl : tok "top" anyident tok ";";
    syntax item += keyDecl : tok "key" anyident tok "by" anyident tok ";";
    syntax item += providerDecl : tok "provider" anyident tok "=" tok "language" anyident tok ";";
    syntax item += validateSumLeavesAtMost : tok "validate" tok "sumleavesatmost" anyident cat numList num str tok ";";
    syntax item += validateUniqueTuples : tok "validate" tok "uniquetuples" anyident cat pathList str tok ";";
    syntax item += validateNonEmptyLeaves : tok "validate" tok "nonemptyleaves" anyident cat numList cat strList tok ";";
    syntax item += validateDefinedRef : tok "validate" tok "definedref" anyident num str tok ";";
    syntax item += validateDefinedRefs : tok "validate" tok "definedrefs" anyident cat numList str tok ";";
    syntax item += validateDefinedLeafList : tok "validate" tok "definedleaflist" anyident num str tok ";";
    syntax item += validateDefinedNodeListRefs : tok "validate" tok "definednodelistrefs" anyident num cat numList str tok ";";
    syntax item += validateLeafOk : tok "validate" tok "leafok" anyident num tok "satisfies" anyident tok "." anyident tok ";";
    syntax item += validateLeafValueInCtorField : tok "validate" tok "leafvalueinctorfield" anyident num cat strList num str tok ";";
    syntax item += validateRefTagIn : tok "validate" tok "reftagin" anyident num cat strList str tok ";";
    syntax item += validateUniqueTuplesInList : tok "validate" tok "uniquetupleslist" anyident num cat pathList str opt cat strList tok ";";
    syntax item += validateListChildDefinedRefs : tok "validate" tok "listchilddefinedrefs" anyident num cat byTagList str tok ";";
    syntax item += validateKeyedLocaleOverlay : tok "validate" tok "keyedlocaleoverlay" anyident num cat strList anyident anyident num num num str tok ";";
    syntax item += validateOutlineNums : tok "validate" tok "outlinenums" anyident num cat numberSourceList tok "satisfies" anyident tok "." anyident str tok ";";
    syntax numList += numList : tok "[" sepby1 num "," tok "]";
    syntax pathList += pathList : tok "[" sepby1 cat numList "," tok "]";
    syntax strItem += strItem : str;
    syntax strList += strList : tok "[" sepby1 cat strItem "," tok "]";
    syntax byTagEntry += byTagEntry : anyident tok ":" cat pathList;
    syntax byTagList += byTagList : tok "[" sepby1 cat byTagEntry "," tok "]";
    syntax strNumEntry += strNumEntry : anyident tok ":" num;
    syntax strNumList += strNumList : tok "[" sepby1 cat strNumEntry "," tok "]";
    syntax numberSource += nsFromLeaf : tok "fromleaf" str num;
    syntax numberSource += nsByTag : tok "bytag" cat strNumList;
    syntax numberSourceList += numberSourceList : tok "[" sepby1 cat numberSource "," tok "]";
    syntax argList += argList : tok "(" sepby1 cat argDecl "," tok ")";
    syntax argDecl += argDeclNamed : anyident tok ":" anyident;
    syntax argDecl += argDeclBare : anyident;
    syntax bindsClause += binds : tok "binds" num tok "in" sepby1 num ",";
    syntax pat += patMetaNode : tok "$" anyident tok "(" opt sepby1 cat pat "," tok ")";
    syntax pat += patMeta : tok "$" anyident;
    syntax pat += patNode : anyident tok "(" opt sepby1 cat pat "," tok ")";
    syntax pat += patLeaf : anyident;
    syntax pat += patStr : str;
    syntax judgRule += judgRule : tok "rule" anyident tok ":" opt sepby1 cat pat "," tok "|-" cat pat opt cat whereClause tok ";";
    syntax whereClause += whereC : tok "where" sepby1 cat pat ",";
    print file : lit "language" sp field 0 sp lit "{" nl indent sep 1 "\n" nl dedent lit "}";
    print surfaceFile : lit "surface" sp field 0 sp lit "for" sp field 1 sp lit "{" nl indent sep 2 "\n" nl dedent lit "}";
    print fragmentDecl : lit "fragment" sp field 0 field 1 field 2 sp lit "{" nl indent sep 3 "\n" nl dedent lit "}";
    print provides : sp lit "provides" sp sep 0 ", ";
    print requires : sp lit "requires" sp sep 0 ", ";
    print sortTree : lit "sort" sp field 0 sp lit "tree" lit ";";
    print sortGraph : lit "sort" sp field 0 sp lit "graph" lit ";";
    print ctorDecl : lit "ctor" sp field 0 sp lit ":" sp field 1 field 2 sep 3 "" lit ";";
    print varCtorDecl : lit "varctor" sp field 0 lit ";";
    print ruleDecl : lit "rule" sp field 0 sp lit ":" sp field 1 sp lit "=>" sp field 2 lit ";";
    print judgmentDecl : lit "judgment" sp field 0 sp lit "{" nl indent sep 1 "\n" nl dedent lit "}";
    print topDecl : lit "top" sp field 0 lit ";";
    print keyDecl : lit "key" sp field 0 sp lit "by" sp field 1 lit ";";
    print providerDecl : lit "provider" sp field 0 sp lit "=" sp lit "language" sp field 1 lit ";";
    print validateSumLeavesAtMost : lit "validate" sp lit "sumleavesatmost" sp field 0 sp field 1 sp field 2 sp strfield 3 lit ";";
    print validateUniqueTuples : lit "validate" sp lit "uniquetuples" sp field 0 sp field 1 sp strfield 2 lit ";";
    print validateNonEmptyLeaves : lit "validate" sp lit "nonemptyleaves" sp field 0 sp field 1 sp field 2 lit ";";
    print validateDefinedRef : lit "validate" sp lit "definedref" sp field 0 sp field 1 sp strfield 2 lit ";";
    print validateDefinedRefs : lit "validate" sp lit "definedrefs" sp field 0 sp field 1 sp strfield 2 lit ";";
    print validateDefinedLeafList : lit "validate" sp lit "definedleaflist" sp field 0 sp field 1 sp strfield 2 lit ";";
    print validateDefinedNodeListRefs : lit "validate" sp lit "definednodelistrefs" sp field 0 sp field 1 sp field 2 sp strfield 3 lit ";";
    print validateLeafOk : lit "validate" sp lit "leafok" sp field 0 sp field 1 sp lit "satisfies" sp field 2 lit "." field 3 lit ";";
    print validateLeafValueInCtorField : lit "validate" sp lit "leafvalueinctorfield" sp field 0 sp field 1 sp field 2 sp field 3 sp strfield 4 lit ";";
    print validateRefTagIn : lit "validate" sp lit "reftagin" sp field 0 sp field 1 sp field 2 sp strfield 3 lit ";";
    print validateUniqueTuplesInList : lit "validate" sp lit "uniquetupleslist" sp field 0 sp field 1 sp field 2 sp strfield 3 sp field 4 lit ";";
    print validateListChildDefinedRefs : lit "validate" sp lit "listchilddefinedrefs" sp field 0 sp field 1 sp field 2 sp strfield 3 lit ";";
    print validateKeyedLocaleOverlay : lit "validate" sp lit "keyedlocaleoverlay" sp field 0 sp field 1 sp field 2 sp field 3 sp field 4 sp field 5 sp field 6 sp field 7 sp strfield 8 lit ";";
    print validateOutlineNums : lit "validate" sp lit "outlinenums" sp field 0 sp field 1 sp field 2 sp lit "satisfies" sp field 3 lit "." field 4 sp strfield 5 lit ";";
    print numList : lit "[" sep 0 ", " lit "]";
    print pathList : lit "[" sep 0 ", " lit "]";
    print strItem : strfield 0;
    print strList : lit "[" sep 0 ", " lit "]";
    print byTagEntry : field 0 lit ":" sp field 1;
    print byTagList : lit "[" sep 0 ", " lit "]";
    print strNumEntry : field 0 lit ":" sp field 1;
    print strNumList : lit "[" sep 0 ", " lit "]";
    print nsFromLeaf : lit "fromleaf" sp strfield 0 sp field 1;
    print nsByTag : lit "bytag" sp field 0;
    print numberSourceList : lit "[" sep 0 ", " lit "]";
    print argList : lit "(" sep 0 ", " lit ")";
    print argDeclNamed : field 0 lit ":" sp field 1;
    print argDeclBare : field 0;
    print binds : sp lit "binds" sp field 0 sp lit "in" sp sep 1 ", ";
    print patMetaNode : lit "$" field 0 lit "(" field 1 lit ")";
    print patMeta : lit "$" field 0;
    print patNode : field 0 lit "(" field 1 lit ")";
    print patLeaf : field 0;
    print patStr : strfield 0;
    print judgRule : lit "rule" sp field 0 sp lit ":" sp field 1 sp lit "|-" sp field 2 field 3 lit ";";
    print whereC : sp lit "where" sp sep 0 ", ";
    top file;
  }
}