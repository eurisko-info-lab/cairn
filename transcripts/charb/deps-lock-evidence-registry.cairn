-- Description: Deps/lock/evidence registry listing, inspection, and status summary
transcript deps-lock-evidence-registry {
  porcelain deps-lock-evidence-registry ;
  expect-summary "evidence total=2" ;
  expect-summary "aligned=1" ;
  expect-summary "drifted=1" ;
}
