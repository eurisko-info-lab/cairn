-- Description: Compliance report registry listing, inspection, and drift status summary
transcript compliance-registry {
  porcelain compliance-registry ;
  expect-summary "reports total=2" ;
  expect-summary "aligned=1" ;
  expect-summary "drifted=1" ;
}
